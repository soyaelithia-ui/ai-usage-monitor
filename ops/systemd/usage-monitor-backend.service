[Unit]
Description=AI usage metrics backend
After=network.target

[Service]
Type=simple
User=usage-monitor
Group=usage-monitor
WorkingDirectory=/opt/ai-usage-monitor
Environment=USAGE_MONITOR_CONFIG=/etc/ai-usage-monitor/backend.json
ExecStart=/usr/bin/node server/main.js
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/ai-usage-monitor
ReadOnlyPaths=-/srv/agent-logs
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
